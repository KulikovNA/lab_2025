FROM base_docker_lab2

RUN find /etc/apt/ -iname '*ros2*' -exec rm -v {} \;

# Устанавливаем нужные утилиты
RUN apt-get update && apt-get install -y curl gnupg2 lsb-release

# Добавляем обновлённый GPG-ключ ROS 2
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg

# Добавляем репозиторий ROS 2 с актуальным ключом
RUN echo "deb [signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
    > /etc/apt/sources.list.d/ros2.list


RUN apt-get update && apt-get install -y \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    ros-humble-gazebo-ros2-control \
    ros-humble-gazebo-ros-pkgs \
    && apt-get clean

# Копирование проекта
WORKDIR /workspace/lab_2025
# COPY ../src /workspace/lab_2025/src
# COPY ../runlaunch.sh /workspace/lab_2025
COPY ../setup_envs.sh /workspace/lab_2025

# Делаем скрипт исполняемым
RUN chmod +x /workspace/lab_2025/setup_envs.sh

# сборка и инициализация проекта
RUN /bin/bash -c '. /opt/ros/humble/setup.bash; colcon build'

# Добавляем необходимые source-строки в .bashrc
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc && \
    echo "source /usr/share/gazebo/setup.sh" >> ~/.bashrc && \
    echo "source /workspace/lab_2025/install/setup.bash" >> ~/.bashrc

WORKDIR /workspace/lab_2025

#ENTRYPOINT [ "/bin/bash","./runlaunch.sh" ]
ENTRYPOINT [ "/bin/bash","./setup_envs.sh"]
